# Vercel Environment Variables Example
# Set these variables in your Vercel Project Settings > Environment Variables

# URL of your Express backend service deployed on Render (without trailing slash)
VITE_API_BASE_URL=https://ai-career-intelligence-backend.onrender.com

# Optional: Separate Python ML Engine URL if deployed separately on Render
# VITE_ML_API_BASE_URL=https://ai-career-intelligence-ml.onrender.com
